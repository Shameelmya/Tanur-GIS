# ---------------------------------------------------------------------------
# Tanur Constituency GIS — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local or real keys.
# ---------------------------------------------------------------------------

# --- Basemap (MapLibre style URL). Default: OpenFreeMap "liberty" style. ---
# Swap for MapTiler / Stadia / Protomaps later without code changes.
NEXT_PUBLIC_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# --- Firebase Web SDK config (client-side; safe to expose, but keep in env) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (server-side only; used by data/scripts/seed-firestore.mjs) ---
# Path to a service-account JSON key file downloaded from the Firebase console.
# Keep this file OUT of git (see .gitignore).
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./serviceAccountKey.json

# --- Feature flags ---
# When "true", the app runs in read-only demo mode with no Firebase writes.
NEXT_PUBLIC_DEMO_MODE=false
